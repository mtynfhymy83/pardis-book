# ---- App ----
APP_HOST=0.0.0.0
APP_PORT=9502
APP_DEBUG=1

# ---- Swoole ----
SWOOLE_WORKER_NUM=4
SWOOLE_ENABLE_CURL_HOOK=false
SWOOLE_HTTP_COMPRESSION=true

# Cache instances of controllers per worker (true = faster, false = fresh each request)
CONTROLLER_CACHE=true

# ---- Auth (JWT) ----
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ALGO=HS256
JWT_TTL=900
REFRESH_TOKEN_TTL=2592000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_ENV=development
ALLOW_FAKE_PROVIDERS=true
DEFAULT_TAX_RATE_BPS=0
RESERVATION_TTL_SECONDS=900
DEFAULT_MINIMUM_ORDER_QUANTITY=5

# ---- Database ----
DB_DSN=pgsql:host=db;port=5432;dbname=pardis
DB_USERNAME=pardis
DB_PASSWORD=pardis
DB_POOL_SIZE=10

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# PostgreSQL:
# DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=app
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# MySQL:
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=app;charset=utf8mb4
# DB_USERNAME=root
# DB_PASSWORD=secret

# Pool tuning (optional)
# DB_MAX_IDLE_TIME=600
# DB_POOL_POP_TIMEOUT_SECONDS=1.0
# DB_POOL_LEAK_DETECTION_ENABLED=1
# DB_POOL_LEAK_THRESHOLD_MS=15000
