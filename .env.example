# ---- App ----
APP_HOST=0.0.0.0
APP_PORT=9502
APP_DEBUG=1

# ---- Swoole ----
SWOOLE_WORKER_NUM=4
SWOOLE_ENABLE_CURL_HOOK=false
SWOOLE_HTTP_COMPRESSION=true

# Cache instances of controllers per worker (true = faster, false = fresh each request)
CONTROLLER_CACHE=true

# ---- Auth (JWT) ----
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ALGO=HS256
JWT_TTL=900
REFRESH_TOKEN_TTL=2592000
ADMIN_SESSION_TTL=2592000
# Used only by scripts/create-admin.php; never commit a real password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
ADMIN_NAME=مدیر فروشگاه
ADMIN_ROLE=admin
# ADMIN_PHONE=+989121234567
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
APP_ENV=development
ALLOW_FAKE_PROVIDERS=true
DEFAULT_TAX_RATE_BPS=0
RESERVATION_TTL_SECONDS=900
DEFAULT_MINIMUM_ORDER_QUANTITY=5
WORKER_POLL_MILLISECONDS=1000
OUTBOX_MAX_ATTEMPTS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_REQUIRED=false
TRUST_PROXY_HEADERS=false

# ---- Private object storage (AWS S3 / S3-compatible) ----
S3_BUCKET=pardis-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
# Optional for MinIO, Cloudflare R2, ArvanCloud, etc.
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=true

# ---- Database ----
DB_DSN=pgsql:host=db;port=5432;dbname=pardis
DB_USERNAME=pardis
DB_PASSWORD=pardis
DB_POOL_SIZE=10

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# PostgreSQL:
# DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=app
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# MySQL:
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=app;charset=utf8mb4
# DB_USERNAME=root
# DB_PASSWORD=secret

# Pool tuning (optional)
# DB_MAX_IDLE_TIME=600
# DB_POOL_POP_TIMEOUT_SECONDS=1.0
# DB_POOL_LEAK_DETECTION_ENABLED=1
# DB_POOL_LEAK_THRESHOLD_MS=15000
